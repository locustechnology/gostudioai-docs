{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GoStudio API",
  "description": "REST API documentation for the GoStudio Watermark Remover — remove watermarks from images with a single authenticated call.",
  "colors": {
    "primary": "#5B16FE",
    "light": "#A077FE",
    "dark": "#5B16FE"
  },
  "fonts": {
    "heading": {
      "family": "Poppins"
    },
    "body": {
      "family": "Plus Jakarta Sans"
    }
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://www.gostudio.ai"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "authentication"]
          },
          {
            "group": "Core Concepts",
            "pages": ["response-format", "errors", "pagination"]
          },
          {
            "group": "Guides",
            "pages": ["guides/watermark-remover"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@gostudio.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open GoStudio",
      "href": "https://www.gostudio.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.gostudio.ai",
      "linkedin": "https://www.linkedin.com/company/106690651",
      "instagram": "https://www.instagram.com/gostudioai/",
      "facebook": "https://www.facebook.com/profile.php?id=61576148559681"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "GoStudio", "href": "https://www.gostudio.ai" },
          { "label": "Support", "href": "mailto:support@gostudio.ai" }
        ]
      },
      {
        "header": "Developers",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Authentication", "href": "/authentication" },
          { "label": "Error Codes", "href": "/errors" }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/docs", "destination": "/introduction", "permanent": true },
    { "source": "/docs/introduction", "destination": "/introduction", "permanent": true },
    { "source": "/docs/quickstart", "destination": "/quickstart", "permanent": true },
    { "source": "/docs/authentication", "destination": "/authentication", "permanent": true },
    { "source": "/docs/response-format", "destination": "/response-format", "permanent": true },
    { "source": "/docs/errors", "destination": "/errors", "permanent": true },
    { "source": "/docs/pagination", "destination": "/pagination", "permanent": true },
    { "source": "/docs/guides/:slug*", "destination": "/guides/:slug*", "permanent": true }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-spec",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "search": {
    "prompt": "Search the GoStudio API docs"
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"]
    }
  }
}
