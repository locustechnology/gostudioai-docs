{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GoStudio API",
  "description": "REST API documentation for the GoStudio v2 API — photo generation, image tools, media upload, watermark removal, and more.",
  "colors": {
    "primary": "#5B16FE",
    "light": "#A077FE",
    "dark": "#5B16FE"
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://www.gostudio.ai"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Overview",
            "pages": ["index"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/watermark-remover",
              "guides/recreate-photo",
              "guides/group-photo",
              "guides/age-modifier",
              "guides/image-to-prompt",
              "guides/job-status"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/pricing",
              "resources/errors",
              "resources/support",
              "resources/release-notes"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Get started",
            "pages": ["api-reference/quickstart", "api-reference/authentication", "api-reference/async-requests"]
          },
          {
            "group": "Recreate",
            "pages": [
              "openapi.yaml POST /api/v2/recreate",
              "openapi.yaml POST /api/v2/profile-photo",
              "openapi.yaml POST /api/v2/recreate-group"
            ]
          },
          {
            "group": "Apps",
            "pages": [
              "openapi.yaml POST /api/v2/apps/age-modifier",
              "openapi.yaml POST /api/v2/apps/watermark-remover",
              "openapi.yaml POST /api/v2/apps/weight-shift",
              "openapi.yaml POST /api/v2/apps/group-photo"
            ]
          },
          {
            "group": "AI Image",
            "pages": [
              "openapi.yaml POST /api/v2/image/create",
              "openapi.yaml POST /api/v2/image/edit",
              "openapi.yaml GET /api/v2/image/info"
            ]
          },
          {
            "group": "AI Video",
            "pages": [
              "openapi.yaml POST /api/v2/video/create",
              "openapi.yaml POST /api/v2/video/keyframes",
              "openapi.yaml POST /api/v2/video/reference",
              "openapi.yaml POST /api/v2/video/edit",
              "openapi.yaml GET /api/v2/video/info"
            ]
          },
          {
            "group": "Jobs",
            "pages": ["openapi.yaml GET /api/v2/jobs/{job_id}"]
          },
          {
            "group": "Profiles",
            "pages": ["openapi.yaml GET /api/v2/profiles"]
          },
          {
            "group": "My data",
            "pages": [
              "openapi.yaml GET /api/v2/my/credit-balance",
              "openapi.yaml GET /api/v2/my/credit-history",
              "openapi.yaml GET /api/v2/my/generations",
              "openapi.yaml GET /api/v2/my/generations/{id}",
              "openapi.yaml GET /api/v2/my/images",
              "openapi.yaml GET /api/v2/my/images/{id}",
              "openapi.yaml GET /api/v2/my/uploads",
              "openapi.yaml GET /api/v2/my/uploads/{id}"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@gostudio.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open GoStudio",
      "href": "https://www.gostudio.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.gostudio.ai",
      "linkedin": "https://www.linkedin.com/company/106690651",
      "instagram": "https://www.instagram.com/gostudioai/",
      "facebook": "https://www.facebook.com/profile.php?id=61576148559681"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "GoStudio",
            "href": "https://www.gostudio.ai"
          },
          {
            "label": "Support",
            "href": "mailto:support@gostudio.ai"
          }
        ]
      },
      {
        "header": "Developers",
        "items": [
          {
            "label": "Quickstart",
            "href": "/api-reference/quickstart"
          },
          {
            "label": "Authentication",
            "href": "/api-reference/authentication"
          },
          {
            "label": "Error Codes",
            "href": "/resources/errors"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/docs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/docs/introduction",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/introduction",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/docs/quickstart",
      "destination": "/api-reference/quickstart",
      "permanent": true
    },
    {
      "source": "/quickstart",
      "destination": "/api-reference/quickstart",
      "permanent": true
    },
    {
      "source": "/docs/authentication",
      "destination": "/api-reference/authentication",
      "permanent": true
    },
    {
      "source": "/authentication",
      "destination": "/api-reference/authentication",
      "permanent": true
    },
    {
      "source": "/docs/errors",
      "destination": "/resources/errors",
      "permanent": true
    },
    {
      "source": "/errors",
      "destination": "/resources/errors",
      "permanent": true
    },
    {
      "source": "/docs/response-format",
      "destination": "/api-reference/async-requests",
      "permanent": true
    },
    {
      "source": "/response-format",
      "destination": "/api-reference/async-requests",
      "permanent": true
    },
    {
      "source": "/docs/pagination",
      "destination": "/api-reference/quickstart",
      "permanent": true
    },
    {
      "source": "/pagination",
      "destination": "/api-reference/quickstart",
      "permanent": true
    },
    {
      "source": "/docs/guides/:slug*",
      "destination": "/guides/:slug*",
      "permanent": true
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-spec",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "search": {
    "prompt": "Search the GoStudio API docs"
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"]
    }
  }
}
